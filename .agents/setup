#!/usr/bin/env bash
set -euo pipefail

step() {
    printf '\n==> %s\n' "$1"
}

step "Installing system dependencies"
packages=(imagemagick librsvg2-bin)
missing_packages=()
for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
        missing_packages+=("$package")
    fi
done
if ((${#missing_packages[@]})); then
    sudo apt-get update
    sudo apt-get install -y "${missing_packages[@]}"
else
    echo "System dependencies are already installed."
fi

step "Installing the repository's Node.js toolchain"
node_version="16.20.2"
case "$(uname -m)" in
    x86_64) node_arch="x64" ;;
    aarch64) node_arch="arm64" ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

node_home="$HOME/.local/share/node-v${node_version}-linux-${node_arch}"
if [[ ! -x "$node_home/bin/node" ]]; then
    archive="node-v${node_version}-linux-${node_arch}.tar.xz"
    temp_dir="$(mktemp -d)"
    trap 'rm -rf "$temp_dir"' EXIT
    curl --fail --location --silent --show-error \
        "https://nodejs.org/dist/v${node_version}/${archive}" \
        --output "$temp_dir/$archive"
    curl --fail --location --silent --show-error \
        "https://nodejs.org/dist/v${node_version}/SHASUMS256.txt" \
        --output "$temp_dir/SHASUMS256.txt"
    (
        cd "$temp_dir"
        grep "  ${archive}$" SHASUMS256.txt | sha256sum --check --strict -
    )
    tar -xJf "$temp_dir/$archive" -C "$HOME/.local/share"
fi

mkdir -p "$HOME/.local/bin"
for executable in node npm npx; do
    ln -sfn "$node_home/bin/$executable" "$HOME/.local/bin/$executable"
done
export PATH="$HOME/.local/bin:$PATH"
echo "Using Node.js $(node --version) and npm $(npm --version)."

step "Installing npm dependencies"
npm ci --no-audit --no-fund

step "Orb setup complete"
